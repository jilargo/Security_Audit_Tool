/* =====================================================================
   Security Audit Tool - Application theme
   Flat, high-contrast enterprise palette with a single accent colour.
   Icon URLs use the "assets/<name>" token and are resolved to absolute
   paths at runtime by gui/main_window.py.
   ===================================================================== */

/* ---------- Base typography ---------- */
QWidget {
    font-family: "Segoe UI", "Segoe UI Variable", "Inter", sans-serif;
    font-size: 10pt;
    color: #0F172A;
    background: transparent;
}

QToolTip {
    background: #0F172A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 9px;
}

/* ---------- Application shell ---------- */
QWidget#root {
    background: #F1F5F9;
}

QWidget#header {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #0B1B34, stop: 0.55 #13345F, stop: 1 #1D4ED8);
}

QFrame#headerAccent {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #38BDF8, stop: 0.5 #6366F1, stop: 1 #22D3EE);
    border: none;
}

QLabel#appTitle {
    color: #FFFFFF;
    font-size: 20pt;
    font-weight: 700;
}

QLabel#appSubtitle {
    color: #AFC6E4;
    font-size: 9.5pt;
}

QLabel#versionBadge {
    color: #DCE9FB;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 9px;
    padding: 3px 9px;
    font-size: 8.5pt;
    font-weight: 600;
}

QWidget#footer {
    background: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}

QScrollArea#bodyScroll {
    background: #F1F5F9;
    border: none;
}

QScrollArea#bodyScroll > QWidget > QWidget {
    background: #F1F5F9;
}

/* ---------- Cards ---------- */
QFrame#card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QFrame#accentBar {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #3B82F6, stop: 1 #1D4ED8);
    border: none;
    border-radius: 2px;
}

QLabel#cardTitle {
    color: #0F172A;
    font-size: 12.5pt;
    font-weight: 700;
}

QLabel#cardSubtitle {
    color: #64748B;
    font-size: 9pt;
}

QFrame#divider {
    background: #EDF1F7;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

QLabel#fieldLabel {
    color: #475569;
    font-size: 8.5pt;
    font-weight: 600;
}

QLabel#chip {
    color: #1D4ED8;
    background: #EFF6FF;
    border: 1px solid #DBEAFE;
    border-radius: 11px;
    padding: 5px 10px;
    font-size: 8.5pt;
    font-weight: 600;
}

QLabel#chipMuted {
    color: #475569;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 11px;
    padding: 5px 10px;
    font-size: 8.5pt;
    font-weight: 600;
}

/* ---------- Form controls ---------- */
QLineEdit,
QComboBox,
QDateEdit {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 9px;
    padding: 8px 12px;
    min-height: 20px;
    color: #0F172A;
    selection-background-color: #1D4ED8;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QComboBox:hover,
QDateEdit:hover {
    border: 1px solid #94A3B8;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus {
    border: 1px solid #2563EB;
    background: #FFFFFF;
}

QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled {
    color: #94A3B8;
    background: #F8FAFC;
}

QLineEdit[state="error"],
QComboBox[state="error"] {
    border: 1px solid #DC2626;
    background: #FEF2F2;
}

/* Note: placeholder colour is set through QPalette (see gui/main_window.py) */

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(assets/chevron-down.png);
    width: 14px;
    height: 14px;
}

QComboBox::down-arrow:on,
QComboBox::down-arrow:hover {
    image: url(assets/chevron-down-active.png);
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #E8F0FE;
    selection-color: #0F172A;
}

/* ---------- Buttons ---------- */
QPushButton#primaryButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #1D4ED8, stop: 1 #3B82F6);
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    min-height: 20px;
    font-size: 10.5pt;
    font-weight: 700;
}

QPushButton#primaryButton:hover {
    background: #1E40AF;
}

QPushButton#primaryButton:pressed {
    background: #1E3A8A;
}

QPushButton#primaryButton:disabled {
    background: #CBD5E1;
    color: #F8FAFC;
}

QPushButton#ghostButton {
    background: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 11px 20px;
    min-height: 20px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton#ghostButton:hover {
    background: #F1F5F9;
    border: 1px solid #94A3B8;
    color: #0F172A;
}

QPushButton#ghostButton:pressed {
    background: #E2E8F0;
}

/* ---------- Inline validation ---------- */
QLabel#errorBanner {
    color: #B91C1C;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    border-left: 3px solid #DC2626;
    border-radius: 9px;
    padding: 10px 14px;
    font-size: 9.5pt;
    font-weight: 600;
}

/* ---------- Progress dialog ---------- */
QDialog#loadingDialog {
    background: #FFFFFF;
}

QLabel#loadingTitle {
    color: #0F172A;
    font-size: 12pt;
    font-weight: 700;
}

QLabel#loadingStep {
    color: #64748B;
    font-size: 9.5pt;
}

QLabel#loadingNote {
    color: #94A3B8;
    font-size: 8.5pt;
}

QProgressBar#auditProgress {
    background: #E8EDF4;
    border: none;
    border-radius: 6px;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
    color: #334155;
    font-size: 8pt;
    font-weight: 700;
}

QProgressBar#auditProgress::chunk {
    border-radius: 6px;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #0EA5E9, stop: 1 #2563EB);
}

/* ---------- Message boxes ---------- */
QMessageBox {
    background: #FFFFFF;
}

QMessageBox QLabel {
    color: #0F172A;
    font-size: 10pt;
}

QMessageBox QLabel#qt_msgbox_exlabel {
    font-size: 22pt;
}

QMessageBox QPushButton {
    background: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 9px;
    padding: 9px 18px;
    min-width: 104px;
    font-weight: 600;
}

QMessageBox QPushButton:hover {
    background: #E2E8F0;
}

QMessageBox QPushButton:default {
    background: #1D4ED8;
    color: #FFFFFF;
    border: 1px solid #1D4ED8;
}

QMessageBox QPushButton:default:hover {
    background: #1E40AF;
}

/* ---------- Calendar popup ---------- */
QCalendarWidget QWidget {
    alternate-background-color: #F8FAFC;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #0F172A;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    outline: none;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #CBD5E1;
}

QCalendarWidget QToolButton {
    color: #0F172A;
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 6px 10px;
    margin: 2px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background: #EFF6FF;
    color: #1D4ED8;
}

QCalendarWidget QMenu {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
}

QCalendarWidget QSpinBox {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 3px 6px;
}

QCalendarWidget QSpinBox:focus {
    border: 1px solid #2563EB;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 5px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 5px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}
